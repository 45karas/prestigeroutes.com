# --- cPanel: set these in "Node.js" → Environment Variables (or paste a .env in the app folder) ---

# SQLite: use an absolute path under your home directory, e.g.
# file:/home/USERNAME/nodeapps/appname/prisma/prod.db
DATABASE_URL="file:./prisma/prod.db"

# openssl rand -base64 32
AUTH_SECRET="paste-a-long-random-secret-here"

# Your live site URL (https, no trailing slash) — must match the domain in cPanel
NEXT_PUBLIC_APP_URL="https://prestigeroutes.com"

# Optional if Auth.js needs an explicit public URL
# AUTH_URL="https://prestigeroutes.com"

NODE_ENV="production"
# cPanel often assigns PORT automatically; only set if your host requires it
# PORT="3000"

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
